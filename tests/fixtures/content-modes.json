      "files": [
        "persona.md",
        "knowledge.json",
        "faq.md"
      ],
      "modes": {
        "version": 1,
        "files": {
          "persona.md": "loaded",
          "faq.md": "loaded",
          "knowledge.json": "data"
        }
      },
      "loaded": [
        "faq.md",
        "persona.md"
      ]
    },
    {
      "name": "unlisted files are not loaded",
      "files": [
        "persona.md",
        "extra.md"
      ],
